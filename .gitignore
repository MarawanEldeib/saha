# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright (SAH-98)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google OAuth client secrets — never commit
client_secret_*.json
client_secret*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Supabase CLI temp files
supabase/.temp/

# Expo / React Native — entire mobile dir is on its own feature branch,
# ignore on master to avoid noise. Remove this line when merging the app.
mobile/

# Emulator debug screenshots
emulator_screen*.png

# Design briefs / local docs
stitch-design-brief.md
